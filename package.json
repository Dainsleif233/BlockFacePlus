{
  "name": "blockface-plus",
  "private": true,
  "version": "0.1.0",
  "description": "BlockFace+ —— BlockFace 的在线协同版：发布底图与头像布局，成员凭链接与密码换头像内容，到期自动清理。",
  "author": "Dainsleif",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.8.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc -b",
    "e2e": "node tools/run-e2e.mjs",
    "dev:api": "edgeone makers dev -n blockface-plus"
  },
  "dependencies": {
    "vue": "^3.5.42",
    "@edgeone/pages-blob": "^0.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.11"
  }
}
