# BlockFace+ · 协同后端环境变量样例
# Copyright 2026 Dainsleif · Apache License 2.0
#
# 用法：
#   sudo install -d -m 0750 -o root -g blockface /etc/blockface-plus
#   sudo install -m 0640 -o root -g blockface deploy/blockface-plus.env.example \
#        /etc/blockface-plus/api.env
#   sudoedit /etc/blockface-plus/api.env     # 至少改掉 BF_DATA_DIR 与 BF_CORS_ORIGINS
#
# 这份文件由 systemd 的 EnvironmentFile= 直接读，因此：
#   - 一行一个 KEY=VALUE，不要写 export、不要写 $(...) 之类的 shell 展开（systemd 不跑 shell）；
#   - # 开头的整行注释可以留，但**行尾注释不行**：systemd 只认整行注释，
#     `BF_CORS_ORIGINS=https://a.com  # 说明` 会把 "# 说明" 一起算进值里，CORS 悄悄失效；
#   - 值里的引号会被 systemd 按 shell 风格去掉（"*" 与 * 等价），所以加不加都行；
#     本文件一律不加引号 —— 少一层「到底去没去引号」的心智负担。
# 改完记得重启：sudo systemctl restart blockface-plus-api
#
# 所有 BF_* 都在进程启动时读一次；整数写错（例如 BF_MAX_LAYERS=1e5）不会静默取默认值，
# 后端会直接打一条中文错误并退出 —— 启动即失败，比跑起来一半才发现上限没生效好定位。
#
# 权限提示：本文件含 CORS 白名单等非敏感配置，本身没有密码；但仍然 0640 root:blockface，
# 因为「能被谁改」比「里面写了什么」更要紧 —— 一个能改 BF_DATA_DIR 的人能决定后端读哪份数据库。

# ---------------------------------------------------------------------------
# 存储
# ---------------------------------------------------------------------------

# SQLite 数据库、底图字节、以及所有运行期状态的根目录。
# 生产固定 /var/lib/blockface-plus（见 docs/deploy-vps.md 的目录与权限一节）：
# 放进 /srv 或代码目录会在 git pull / 重新部署时被顺手指到，数据目录必须和代码目录分开。
# 注意它下面会生成 base/（底图字节）与 bfp.sqlite3（元数据）——备份要整个目录一起备。
# 相对路径是相对 backend/ 目录解析的（不是相对 cwd），所以写 ./data 会落到 backend/data；
# 生产请写绝对路径，免得「在哪个目录敲的命令」决定数据落在哪。
BF_DATA_DIR=/var/lib/blockface-plus

# ---------------------------------------------------------------------------
# 跨域：前端静态产物在边缘 Pages，后端在 VPS，两者不同源，必须显式放行
# ---------------------------------------------------------------------------

# 逗号分隔的来源白名单。默认 * 只适合本机联调，生产必须写死 Pages 域名：
# 带上 https://、只写来源（scheme+host+port），不要带路径、不要带结尾斜杠。
# 多个来源用英文逗号分隔，不要加空格也不会出错，但加了更易读。
BF_CORS_ORIGINS=https://your-pages-domain.pages.dev

# 反向代理传进来的 Host 白名单，逗号分隔；默认 * 表示不校验。
# 走反向代理（nginx 或 Caddy）时填后端自己的域名；sniff 到有人在拿 IP 直接怼 uvicorn 时可以收口成这一个值。
BF_TRUSTED_HOSTS=*

# ---------------------------------------------------------------------------
# 上限：全部可覆盖，默认值见 docs/collab-api.md 第 4 节（比旧云函数版本放宽很多）
# ---------------------------------------------------------------------------
# 下面这些**不必**逐个取消注释 —— 不写就是用默认值。这里全部列出是为了让你知道
# 有哪些旋钮、默认值是多少、以及动了它要同步改哪里（尤其是反向代理那一侧）。

# 一间房最多多少行头像（默认 10000，旧云函数版本 512）。
# 这个值越大，一次 GET /api/rooms/{id} 要读的行越多，落在「进房快慢」而不是「存不存得下」。
#BF_MAX_LAYERS=10000

# 单条内嵌皮肤 data URI 的字符数上限（默认 32000000，旧版本 1500000）。
# 只影响一条头像能带多大的贴图，不占文件系统 —— 皮肤是内嵌在行里的，底图才走文件。
#BF_MAX_SKIN_DATA_URL_CHARS=32000000

# 底图字节上限（默认 134217728 = 128MiB，旧版本 10MiB）。
# 改大之后必须同步改反向代理的请求体上限，否则请求根本到不了后端：
#   nginx → client_max_body_size        （deploy/nginx-blockface-plus.conf，样例 256m）
#   Caddy → request_body { max_size .. }（deploy/caddy-blockface-plus.conf，样例 536870912 = 512MiB）
# 并且反代那个值要留出 multipart 的额外开销（表单字段与 boundary，后端侧留了 1MiB 余量）。
#BF_MAX_BASE_IMAGE_BYTES=134217728

# 画布边长上限（默认 65536）与图层坐标绝对值上限（默认 10000000）。
#BF_MAX_DOC_SIZE=65536
#BF_MAX_POSITION=10000000

# 图层尺寸区间（默认 1 / 262144）。
#BF_MIN_LAYER_SIZE=1
#BF_MAX_LAYER_SIZE=262144

# 头像名长度上限（默认 512）。
#BF_MAX_AVATAR_NAME=512

# JSON 请求体上限（默认 268435456 = 256MiB，旧云函数平台硬限 6MiB）。
# 批量首刷几千行头像时，这个值才是真正的天花板；它同时也是反向代理请求体上限的对齐目标。
# 记住反代拦下的 413 是纯文本，后端的 413 是 {"error": "..."} —— 收到哪一种就知道是谁拦的。
#BF_MAX_JSON_BODY_BYTES=268435456

# 建房时可选的最长过期天数（默认 3650；前端 UI 固定给 3/7/14/30/90）。
#BF_MAX_EXPIRY_DAYS=3650

# ---------------------------------------------------------------------------
# 密码试错限流（按房间计数，不是按 IP）
# ---------------------------------------------------------------------------

# 窗口长度与窗口内允许的失败次数（默认 60 秒 / 20 次，旧版本 10 次）。
# 调大 BF_AUTH_MAX_FAILS 会让暴力破解更从容，调小则更容易被恶意刷房号的人拿来拒绝服务
# （知道房间号的人能故意把房主挡在门外一个窗口），按你的信任模型取舍。
#BF_AUTH_WINDOW_SECONDS=60
#BF_AUTH_MAX_FAILS=20

# ---------------------------------------------------------------------------
# 生命周期与后台清扫
# ---------------------------------------------------------------------------

# 建房后一直没传底图的草稿房，多久算废弃（默认 86400 秒 = 1 天）。
# 草稿房没有底图字节，留着几乎不占空间，但会在运维列表里越积越多。
#BF_DRAFT_TTL_SECONDS=86400

# 后台清扫间隔（默认 1800 秒；设 0 完全关闭，只保留「读到时惰性过期」）。
# 过期房间在被清扫前仍然能被读到并由读路径就地删除，所以关掉它不会泄漏数据，
# 只是让 delete 从「定时」变成「下次有人碰它」——单人长期运行的实例可以关掉省一次定时唤醒。
#BF_SWEEP_INTERVAL_SECONDS=1800

# ---------------------------------------------------------------------------
# 监听地址（只在 systemd 之外直接 `python -m bfp` 自启时生效）
# ---------------------------------------------------------------------------
# systemd 那份 unit 把 --host/--port 写在 ExecStart 里，所以这里改了不影响 systemd 启动的服务。
# 保持 127.0.0.1：后端不做 TLS、不做限速、不做静态托管，让它只听回环、由反向代理对外，是最省心的边界。
#BF_HOST=127.0.0.1
#BF_PORT=8088
