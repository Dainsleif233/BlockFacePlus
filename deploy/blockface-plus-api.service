# BlockFace+ · 协同后端 systemd unit 样例
# Copyright 2026 Dainsleif · Apache License 2.0
#
# 安装：
#   sudo install -m 0644 deploy/blockface-plus-api.service /etc/systemd/system/blockface-plus-api.service
#   sudoedit /etc/systemd/system/blockface-plus-api.service     # 按实际路径改 /srv/blockface-plus 与 User
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now blockface-plus-api
#   systemctl status blockface-plus-api --no-pager
#
# 前置条件（缺一样都会起不来，具体命令见 docs/deploy-vps.md）：
#   1. 代码放在 /srv/blockface-plus，已用 uv 同步过依赖（backend/.venv 存在且属主是 User）；
#   2. /etc/blockface-plus/api.env 存在（从 deploy/blockface-plus.env.example 改出来）；
#   3. uv 与 uvicorn 的路径和下面 ExecStart / Environment 一致。
#
# 这份 unit 刻意不监听 0.0.0.0：uvicorn 不做 TLS、不做限速、不托管静态文件，
# 让它只听回环、由反向代理（nginx 或 Caddy，两份样例都在 deploy/）对外，是把「谁能碰到这个进程」
# 收成一个点的最省心做法。

[Unit]
Description=BlockFace+ 协同后端 (FastAPI / uvicorn)
Documentation=file:///srv/blockface-plus/docs/deploy-vps.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=blockface
Group=blockface

# 数据目录用 systemd 的 StateDirectory 声明式创建：它会自动建出 /var/lib/blockface-plus、
# 按 User 归属并赋予读写权限，还会把这条路径隐式加进下面的 ProtectSystem 白名单。
# 好处是「目录权限」这一项从此不需要靠文档里的 chown 命令维持 —— 换台机器、改用户名都不会漏。
# BF_DATA_DIR 必须与它一致（deploy/blockface-plus.env.example 里就是 /var/lib/blockface-plus）。
StateDirectory=blockface-plus
StateDirectoryMode=0750
# uv 的包缓存：同样是声明式的，指向 /var/cache/blockface-plus。
CacheDirectory=blockface-plus
CacheDirectoryMode=0750

WorkingDirectory=/srv/blockface-plus/backend

# 环境变量从这份文件读，unit 里不写业务配置。
# 后果要记住：改完 api.env 必须 systemctl restart，reload 不会重读 EnvironmentFile。
EnvironmentFile=/etc/blockface-plus/api.env

# systemd 不继承登录 shell 的 PATH（默认只有 /usr/bin:/bin），
# 所以 uv 自带的环境变量要在这里显式给全，否则 uv 会去 $HOME/.cache 找缓存 ——
# ProtectHome=read-only 保留 $HOME 可读；UV_CACHE_DIR 则把缓存写入声明的缓存目录。
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=UV_CACHE_DIR=/var/cache/blockface-plus
# 别让 uv 反问任何东西：没有 tty，一旦它想交互就是「卡住直到超时」。
Environment=UV_NO_PROGRESS=1
Environment=PYTHONUNBUFFERED=1

# uv run 而不是直接调 .venv/bin/uvicorn：依赖清单（pyproject.toml + uv.lock）变了之后
# 一次 restart 就能把环境对齐，不用记得回来手动 sync。--frozen 是不许它顺手改 uv.lock ——
# 生产机上改动的锁文件属于「谁都不知道线上跑的是哪套依赖」的开端。
# --no-dev 把 pytest / httpx 那套只在开发与 CI 需要的依赖挡在服务器之外。
# 若你希望启动路径上完全不要有 uv（启动更快、更少活动部件），把下面这行换成：
#   ExecStart=/srv/blockface-plus/backend/.venv/bin/uvicorn bfp.main:app --host 127.0.0.1 --port 8088
ExecStart=/usr/local/bin/uv run --frozen --no-dev uvicorn bfp.main:app --host 127.0.0.1 --port 8088 --workers 1 --no-server-header

# --workers 1 不是省事，是必须：房间的写锁活在进程内存里（aiosqlite 单连接 + 应用层写锁），
# 多开 worker 等于把「同一把锁」变成每个进程各拿一把，行级差量的并发语义就没人保证了。
# 要横向扩容，先把锁挪出进程（SQLite 的 BEGIN IMMEDIATE 或外部锁服务），再动这个数字。

Restart=always
RestartSec=3
# uvicorn 收到 SIGINT 会走 lifespan 关闭流程（收尾后台清扫任务、关数据库连接），
# 默认的 SIGTERM 它同样处理，留出 20 秒足够把一次在途的写事务落盘。
TimeoutStopSec=20
KillSignal=SIGTERM

# 日志一律走 journald（StandardOutput=journal 是默认值，写出来是为了让下面这句一眼可查）：
#   journalctl -u blockface-plus-api -f
# 不要加 StandardOutput=file: —— 自己转日志就要自己处理轮转和磁盘打满。
StandardOutput=journal
StandardError=journal
SyslogIdentifier=blockface-plus-api

# 沙箱：只允许写「数据目录 + 缓存目录」，其余文件系统（/usr、/boot、/etc）一律只读。
# ProtectSystem=strict 生效后，StateDirectory/CacheDirectory 那两条已经自动开了对应白名单，
# 这里再显式列一次是给「改了 StateDirectory 名字却忘了改这里」的情况兜底。
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
UMask=0027

[Install]
WantedBy=multi-user.target
