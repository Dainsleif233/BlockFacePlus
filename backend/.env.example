# BlockFace+ 协同后端环境变量样例
# 用法：cp .env.example .env 后按需改；systemd 用 EnvironmentFile= 指向你自己的 env 文件。
# 只有下面这些变量会被读取，变量名之外的都不认（尤其是密码/密钥类，本服务没有）。
# 所有值都在进程启动时读一次；非法整数会直接让服务起不来（fail fast，不静默取默认值）。

# ------------------------------------------------------------------ 存储
# SQLite 库（bfp.sqlite3）与底图字节（base/）的根目录。
# 相对路径一律相对 backend/ 目录解析（默认 ./data 就是 backend/data，与启动时的 cwd 无关）；
# 生产建议写绝对路径。
BF_DATA_DIR=./data

# ------------------------------------------------------------------ 网络
# 逗号分隔的跨域来源白名单；* 表示不限（本服务不用 cookie，所以允许 *）
BF_CORS_ORIGINS=*
# 逗号分隔的 Host 白名单；* 表示不限。生产建议填真实域名
BF_TRUSTED_HOSTS=*
# 只在 `python -m bfp` 自启时生效；用 uvicorn 命令行时以命令行为准
BF_HOST=127.0.0.1
BF_PORT=8088

# ------------------------------------------------------------------ 公开上限（/api/config 会回给前端）
BF_MAX_LAYERS=10000
BF_MAX_SKIN_DATA_URL_CHARS=32000000
BF_MAX_BASE_IMAGE_BYTES=134217728
BF_MAX_DOC_SIZE=65536
BF_MAX_POSITION=10000000
BF_MIN_LAYER_SIZE=1
BF_MAX_LAYER_SIZE=262144
BF_MAX_AVATAR_NAME=512
BF_MAX_JSON_BODY_BYTES=268435456
BF_MAX_EXPIRY_DAYS=3650

# ------------------------------------------------------------------ 安全与生命周期
# 密码试错限流：一个窗口内允许失败多少次，超过就把这间房锁一个窗口
BF_AUTH_WINDOW_SECONDS=60
BF_AUTH_MAX_FAILS=20
# 建房后一直没传底图的草稿房多久清掉（秒）
BF_DRAFT_TTL_SECONDS=86400
# 后台清扫间隔（秒）；0 = 关闭后台清扫（仍可用 bfp-ops sweep 手动扫）
BF_SWEEP_INTERVAL_SECONDS=1800
