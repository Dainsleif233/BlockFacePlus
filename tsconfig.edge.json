{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.edge.tsbuildinfo",
    "target": "es2022",
    "lib": ["ES2022", "DOM"],
    "types": [],
    "skipLibCheck": true,

    /* 边缘函数由平台自己打包，导入里不带扩展名 —— 用 bundler 解析，跟平台一致 */
    "module": "esnext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["edge-functions/**/*.ts"]
}